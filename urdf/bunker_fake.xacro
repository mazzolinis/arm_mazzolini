<?xml version="1.0" encoding="utf-8"?>
<robot  name="weeder_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="bunker_fake">
        
        <xacro:property name="PI" value="3.141592" />
        <xacro:property name="bunker_fake_mesh" value="file://$(find arm_mazzolini)/meshes/stl/Bunker_fake_v2.stl"/>
        <xacro:property name="base_mass" value="130"/>
        <xacro:property name="box_size_x" value="0.852"/>
        <xacro:property name="box_size_y" value="0.545"/>
        <xacro:property name="box_size_z" value="0.400"/>
        <xacro:property name="wheel_mass" value="5"/>
        <xacro:property name="wheel_radius" value="0.18"/>
        <xacro:property name="wheel_length" value="0.15"/>
        <xacro:property name="wheel_pos_x" value="${box_size_x/2}"/>
        <xacro:property name="wheel_pos_y" value="${(box_size_y + wheel_length)/2}"/>
        <xacro:property name="wheel_pos_z" value="${0.465 - box_size_z - wheel_radius}"/>

        <link name="base_link"/>

        <link
            name="inertial">
            <inertial>
            <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0 0 0" />
                <mass
                    value="${base_mass}" />
                <inertia
                    ixx="15.7"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="26.0"
                    iyz="0.0"
                    izz="33.42" />
            </inertial>
            <visual>
                <origin
                    xyz="0.0 0.0 ${-box_size_z/2-0.065}"
                    rpy="0 0 0" />
                <geometry>
                    <mesh filename="${bunker_fake_mesh}" />
                    <!-- <box size="${box_size_x} ${box_size_y} ${box_size_z}" /> -->
                </geometry>
                <material
                    name="">
                    <color
                    rgba="0.5 0.5 0.5 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <geometry>
                    <box size="${box_size_x} ${box_size_y} ${box_size_z}" />
                </geometry>
            </collision>
        </link>

        <joint
            name="just_for_inertia"
            type="fixed">
            <parent
                link="base_link" />
            <child
                link="inertial" />
            <origin
                xyz="0 0 0"
                rpy="0 0 0" />
        </joint>
        
        <xacro:macro name="bunker_wheel" params="name pos_x pos_y">
            <link 
                name="${name}">
                <inertial>
                <origin
                    xyz="0.0 0.0 0.0"
                    rpy="0 ${PI/2} 0" />
                <mass
                    value="${wheel_mass}" />
                <inertia
                    ixx="${wheel_mass*(wheel_radius*wheel_radius/4 + wheel_length*wheel_length/12)}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${wheel_mass*wheel_radius*wheel_radius/2}"
                    iyz="0.0"
                    izz="${wheel_mass*(wheel_radius*wheel_radius/4 + wheel_length*wheel_length/12)}" />
                </inertial>
                <!-- <visual>
                    <origin
                        xyz="0.0 0.0 0.0"
                        rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_length}" />
                    </geometry>
                    <material
                        name="">
                        <color
                        rgba="0.5 0.5 0.5 1" />
                    </material>
                </visual> -->
                <collision>
                    <origin
                        xyz="0.0 0.0 0.0" 
                        rpy="${PI/2} 0 0" />
                    <geometry>
                        <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_length}" />
                    </geometry>
                </collision>
            </link>

            <joint name="${name}_joint" type="continuous">
                <parent
                    link="base_link" />
                <child
                    link="${name}" />
                <origin
                    xyz="${pos_x} ${pos_y} ${wheel_pos_z}"
                    rpy="0 0 0" />
                <axis
                    xyz="0 1 0" />
                <limit effort="10000" velocity="100"/>
                <dynamics damping="0.1" friction="0.0"/>
            </joint>

            <gazebo reference="${name}">
                <mu1>3.0</mu1>
                <mu2>1.0</mu2>
                <kp>10000.0</kp>
                <kd>10.0</kd>
                <minDepth>0.001</minDepth>
            </gazebo>
           
        </xacro:macro>

        <xacro:bunker_wheel name="front_left_wheel" pos_x="${wheel_pos_x}" pos_y="${wheel_pos_y}"/>
        <xacro:bunker_wheel name="rear_left_wheel" pos_x="-${wheel_pos_x}" pos_y="${wheel_pos_y}"/>
        <xacro:bunker_wheel name="front_right_wheel" pos_x="${wheel_pos_x}" pos_y="-${wheel_pos_y}"/>
        <xacro:bunker_wheel name="rear_right_wheel" pos_x="-${wheel_pos_x}" pos_y="-${wheel_pos_y}"/>
    </xacro:macro>

    <!-- Do not add plugins here -->
    <xacro:macro name="wheel_control" params="name">
        <joint name="${name}_joint">
            <command_interface name="velocity">
                <param name="min">-100</param>
                <param name="max">100</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

</robot>
